{
  "name": "iptrade-app",
  "private": true,
  "version": "4.2.0",
  "description": "IPTRADE — free, open-source trade copier for MetaTrader 4/5 and cTrader",
  "author": "IPTRADE COPIER LLC",
  "type": "module",
  "main": "electron/dist/main.js",
  "scripts": {
    "dev": "node scripts/run-electron-dev.mjs",
    "build": "node scripts/build.mjs",
    "build:frontend": "vite build --mode production",
    "build:electron": "node -e \"require('fs').rmSync('electron/dist',{recursive:true,force:true})\" && node node_modules/typescript/bin/tsc -p electron/tsconfig.json && node -e \"require('fs').writeFileSync('electron/dist/package.json', JSON.stringify({type:'commonjs'}))\""
  },
  "dependencies": {
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "ansi-to-react": "^6.2.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.14.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.13.0",
    "strip-ansi": "^7.2.0",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "electron": "^28.0.0",
    "electron-builder": "^26.8.1",
    "fs-extra": "^11.2.0",
    "postcss": "^8.4.49",
    "rcedit": "^4.0.1",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.15",
    "to-ico": "^1.1.5",
    "typescript": "^5.9.3",
    "vite": "^6.0.3",
    "ws": "^8.20.0"
  },
  "build": {
    "appId": "com.iptrade.app",
    "productName": "IPTRADE",
    "copyright": "Copyright © 2026 Joaquin Metayer",
    "protocols": {
      "name": "IPTRADE URL",
      "schemes": [
        "iptrade"
      ]
    },
    "directories": {
      "output": "release",
      "buildResources": "public"
    },
    "files": [
      "electron/dist/**/*",
      "dist/**/*",
      "public/icon.png",
      "public/icon.ico",
      "public/iconTrayTemplate.png",
      "public/iconTrayTemplate@2x.png",
      "public/dmg.png",
      "public/installer-sidebar.bmp",
      "public/installer-sidebar.png",
      "public/sidebar.png",
      "public/dmg.png",
      "public/welcome.txt",
      "public/conclusion.txt"
    ],
    "asarUnpack": [
      "public/iconTrayTemplate.png",
      "public/iconTrayTemplate@2x.png"
    ],
    "extraResources": [],
    "mac": {
      "category": "public.app-category.finance",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "artifactName": "IPTRADE-Setup.${ext}",
      "icon": "public/icon.png",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "notarize": false,
      "entitlements": "electron/entitlements.mac.plist",
      "entitlementsInherit": "electron/entitlements.mac.plist",
      "extendInfo": {
        "CFBundleDisplayName": "IPTRADE",
        "CFBundleName": "IPTRADE"
      },
      "identity": null
    },
    "win": {
      "icon": "public/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "IPTRADE.${ext}",
      "forceCodeSigning": false,
      "verifyUpdateCodeSignature": false,
      "signAndEditExecutable": true,
      "signExts": [],
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "artifactName": "${productName}-Setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "IPTRADE",
      "include": "build/installer.nsh",
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico",
      "installerHeaderIcon": "public/icon.ico",
      "installerSidebar": "public/installer-sidebar.bmp",
      "uninstallerSidebar": "public/installer-sidebar.bmp"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "public/icon.png"
    },
    "afterPack": "electron/dist/afterPack.js"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jometa9/IPTRADE-APP.git"
  },
  "homepage": "https://iptradecopier.com"
}
